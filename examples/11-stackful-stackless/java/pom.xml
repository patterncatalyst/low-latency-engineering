<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.patterncatalyst.lowlat</groupId>
    <artifactId>lowlat-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>stackful-stackless-java</artifactId>
  <name>stackful-stackless-java (Ch11 platform and virtual threads, see ../README.md)</name>

  <properties>
    <shade.mainClass>io.patterncatalyst.lowlat.ch11.Main</shade.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.openhft</groupId>
      <artifactId>affinity</artifactId>
    </dependency>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>lowlat-proto-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>measure-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>line-consumer-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>stackful-stackless-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${chronicle.jvmArgs} -Dchronicle.analytics.disable=true</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
