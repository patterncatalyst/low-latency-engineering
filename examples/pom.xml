<?xml version="1.0" encoding="UTF-8"?>
<!-- Java aggregator for the book's examples. Versions mirror /versions.env and
     _plans/dependency-pins.md; every version is exact. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.patterncatalyst.lowlat</groupId>
  <artifactId>lowlat-examples</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Low-Latency Engineering examples</name>

  <modules>
    <module>common/proto-java</module>
    <module>common/measure-java</module>
    <module>common/line-simulator/consumers/java</module>
    <module>01-latency-distribution/java</module>
    <module>02-littles-amdahl/java</module>
    <module>03-coordinated-omission/java</module>
    <module>04-benchmark-harnesses/java</module>
    <module>05-jvm-costs/java</module>
    <module>06-gc-tails/java</module>
    <module>07-offheap-lockfree/java</module>
    <module>08-zero-copy-flat/java</module>
    <module>09-eliminating-work/java</module>
    <module>10-lockfree-waitfree/java</module>
    <module>11-stackful-stackless/java</module>
    <module>12-io-engines/java</module>
    <module>13-where-code-runs/java</module>
    <module>14-preempt-rt/java</module>
    <module>15-cpu-partitioning/java</module>
    <!-- Standalone (no parent): Quarkus imports its own BOM, which would clash with the JUnit and
         Jackson versions this parent manages. It repeats the parent's enforcer rules and compiler policy. -->
    <module>12-io-engines/quarkus</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- protoc 36.2 = protobuf-java 4.36.2 (Maven version scheme) -->
    <protobuf.version>4.36.2</protobuf.version>
    <hdrhistogram.version>2.2.2</hdrhistogram.version>
    <jackson.version>3.2.4</jackson.version>
    <jmh.version>1.37</jmh.version>
    <!-- r02 pins (versions.env, _plans/dependency-pins.md "r02 pins") -->
    <agrona.version>2.7.0</agrona.version>
    <disruptor.version>4.0.0</disruptor.version>
    <jol.version>0.17</jol.version>
    <!-- chronicle-bom 2026.26 manages queue 2026.7, map 2026.1, bytes 2026.4, affinity 2026.2 -->
    <chronicle-bom.version>2026.26</chronicle-bom.version>
    <!-- r03 pin (_plans/dependency-pins.md "r03 pins"): OpenJDK jcstress, Ch10 litmus tests -->
    <jcstress.version>0.16</jcstress.version>
    <!-- JVM arguments Chronicle needs on Java 17 and later. Verbatim from the `java17` profile
         (activation jdk [17,)) of net.openhft:root-parent-pom:2026.0, the parent POM of
         every Chronicle 2026.x module and the source of the ${jvm.requiredArgs} that
         Chronicle's own builds hand to surefire. The Queue, Map and Core
         docs at the pinned tags name the requirement but give no list; this profile is the
         list Chronicle builds and tests with.
         https://repo1.maven.org/maven2/net/openhft/root-parent-pom/2026.0/root-parent-pom-2026.0.pom
         The shaded jar's manifest cannot carry them (the Add-Opens manifest entry is honoured only
         for `java -jar`), so run scripts pass the same list.
         The last line is not Chronicle's: JNA (used by Affinity; managed at ${jna.version} below) calls
         System::load, which JDK 25 reports as a restricted-method warning unless native
         access is enabled.
         Chronicle Core also posts usage analytics unless -Dchronicle.analytics.disable=true; the
         surefire and exec arguments below, and verify.sh, add it after this list. -->
    <chronicle.jvmArgs>--add-exports=java.base/jdk.internal.misc=ALL-UNNAMED --add-exports=java.base/jdk.internal.ref=ALL-UNNAMED --add-exports=java.base/jdk.internal.util=ALL-UNNAMED --add-exports=java.base/sun.nio.ch=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=jdk.compiler/com.sun.tools.javac=ALL-UNNAMED --enable-native-access=ALL-UNNAMED</chronicle.jvmArgs>
    <jna.version>5.19.1</jna.version>
    <junit.version>6.1.3</junit.version>

    <!-- Main class of a module's shaded jar; empty for jars with several entry points. -->
    <shade.mainClass></shade.mainClass>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <protobuf-maven-plugin.version>5.1.11</protobuf-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.patterncatalyst.lowlat</groupId>
        <artifactId>lowlat-proto-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.patterncatalyst.lowlat</groupId>
        <artifactId>measure-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.patterncatalyst.lowlat</groupId>
        <artifactId>line-consumer-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>org.hdrhistogram</groupId>
        <artifactId>HdrHistogram</artifactId>
        <version>${hdrhistogram.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.agrona</groupId>
        <artifactId>agrona</artifactId>
        <version>${agrona.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lmax</groupId>
        <artifactId>disruptor</artifactId>
        <version>${disruptor.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jol</groupId>
        <artifactId>jol-core</artifactId>
        <version>${jol.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jcstress</groupId>
        <artifactId>jcstress-core</artifactId>
        <version>${jcstress.version}</version>
      </dependency>
      <!-- JNA for every module: Affinity (via the BOM below) pins 5.5.0 and jcstress-core 5.8.0;
           managed here at the newest stable so 07, 09 and 10 resolve one version. Declared before
           the BOM import, so it wins. -->
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna-platform</artifactId>
        <version>${jna.version}</version>
      </dependency>
      <!-- OpenHFT: queue, map, bytes and affinity versions come from this BOM. -->
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-bom</artifactId>
        <version>${chronicle-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module runs JUnit tests. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <showWarnings>true</showWarnings>
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
          <executions>
            <execution>
              <id>shade</id>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>${shade.mainClass}</mainClass>
                    <manifestEntries>
                      <Multi-Release>true</Multi-Release>
                    </manifestEntries>
                  </transformer>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                </transformers>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/MANIFEST.MF</exclude>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                      <exclude>module-info.class</exclude>
                      <exclude>META-INF/versions/*/module-info.class</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>io.github.ascopes</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
