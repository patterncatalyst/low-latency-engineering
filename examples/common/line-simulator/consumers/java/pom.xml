<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.patterncatalyst.lowlat</groupId>
    <artifactId>lowlat-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../../pom.xml</relativePath>
  </parent>

  <artifactId>line-consumer-java</artifactId>
  <name>line-consumer-java (Java line consumer, see consumers/README.md)</name>

  <properties>
    <shade.mainClass>io.patterncatalyst.lowlat.line.Consumer</shade.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>lowlat-proto-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>measure-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jol</groupId>
      <artifactId>jol-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>line-consumer-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <LOWLAT_PROFILE>${project.basedir}/../../../measure-fixtures/profile.json</LOWLAT_PROFILE>
          </environmentVariables>
          <systemPropertyVariables>
            <lowlat.examples.dir>${project.basedir}/../../../..</lowlat.examples.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
