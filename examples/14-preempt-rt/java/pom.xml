<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.patterncatalyst.lowlat</groupId>
    <artifactId>lowlat-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>preempt-rt-java</artifactId>
  <name>preempt-rt-java (Ch14 periodic wake on a SCHED_FIFO thread through JNA, see ../README.md)</name>

  <properties>
    <shade.mainClass>io.patterncatalyst.lowlat.ch14.Main</shade.mainClass>
  </properties>

  <dependencies>
    <!-- Version from the parent's dependencyManagement (jna.version). -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
    </dependency>
    <dependency>
      <groupId>io.patterncatalyst.lowlat</groupId>
      <artifactId>measure-java</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>preempt-rt-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JNA loads its native stub with System.load; JDK 25 warns about that unless native access is granted. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
