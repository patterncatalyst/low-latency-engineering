# versions.env - the one machine-readable source of pinned versions.
# Sourced by scripts/deps/build-protobuf.sh and scripts/check-prereqs.sh;
# examples/cmake/deps.cmake and examples/pom.xml / pyproject.toml repeat the
# values in their own syntax and must be kept in step with this file.
# Human-readable provenance (licence, source, survey date): _plans/dependency-pins.md
# Tarball hashes match the sha256 digests GitHub publishes for these release
# assets (checked 2026-10-21 via the releases API).

# protobuf release train: protoc 36.N = Java 4.36.N = Python 7.36.N = C++ 7.36.N
PROTOBUF_VERSION="36.2"
PROTOBUF_TAG="v36.2"
PROTOBUF_URL="https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protobuf-36.2.tar.gz"
PROTOBUF_SHA256="3d9642a662d10e68ebae5e53f14dcce5105684212d5078f8e0d47d1ab3ae6b64"
PROTOBUF_JAVA_VERSION="4.36.2"
PROTOBUF_PYTHON_VERSION="7.36.2"

# abseil-cpp: the LTS release protobuf v36.2 itself requires
ABSL_VERSION="20250512.1"
ABSL_URL="https://github.com/abseil/abseil-cpp/releases/download/20250512.1/abseil-cpp-20250512.1.tar.gz"
ABSL_SHA256="9b7a064305e9fd94d124ffa6cc358592eb42b5da588fb4e07d09254aa40086db"
