# PREEMPT_RT fragment for the Fedora 44 kernel (kernel-7.2.x-200.fc44).
#
# Installed by scripts/lab/build-rt-kernel.sh as SOURCES/kernel-local, which the
# Fedora kernel.spec (Source3001) merges into every flavour's config before
# `make olddefconfig`. Each entry below was checked against the v7.2.11 Kconfig
# files (kernel/Kconfig.preempt, kernel/time/Kconfig, kernel/Kconfig.hz,
# kernel/rcu/Kconfig) and against Fedora's stock kernel-x86_64-fedora.config.
# Options marked "stock" are already set that way by Fedora; they are pinned here
# so a future Fedora config change cannot silently weaken the RT kernel.

# kernel/Kconfig.preempt: PREEMPT_RT depends on EXPERT && ARCH_SUPPORTS_RT &&
# !COMPILE_TEST. x86 selects ARCH_SUPPORTS_RT. Stock already has EXPERT=y.
CONFIG_EXPERT=y

# The switch itself. It selects PREEMPTION, turns spinlock_t/rwlock_t into
# sleeping priority-inheriting locks and forces threaded interrupts.
CONFIG_PREEMPT_RT=y

# PREEMPT_NONE and PREEMPT_VOLUNTARY both carry "depends on !PREEMPT_RT", so the
# "Preemption Model" choice is left with PREEMPT or PREEMPT_LAZY. Stock selects
# PREEMPT_LAZY (the 7.2 default on x86). Lazy preemption delays preemption of
# SCHED_NORMAL tasks to protect throughput; an RT kernel exists to avoid that
# delay, so choose full PREEMPT and leave LAZY off.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# PREEMPT_DYNAMIC lets a boot parameter (preempt=) change the model. The lab
# kernel must be fully preemptible regardless of the command line, so the model
# is fixed at build time. (Fedora's own -rt flavour keeps it; this is stricter.)
# CONFIG_PREEMPT_DYNAMIC is not set

# Restores the old softirq big-lock behaviour for debugging only; it adds
# latency, so keep it off. Stock off.
# CONFIG_PREEMPT_RT_NEEDS_BH_LOCK is not set

# kernel/time/Kconfig: NO_HZ_FULL depends on SMP, HAVE_CONTEXT_TRACKING_USER and
# HAVE_VIRT_CPU_ACCOUNTING_GEN (all true on x86_64) and selects NO_HZ_COMMON,
# RCU_NOCB_CPU, VIRT_CPU_ACCOUNTING_GEN and CPU_ISOLATION. It is the
# nohz_full= / isolcpus= tick suppression that the cpu-partitioning tuned
# profile uses. Stock.
CONFIG_NO_HZ_FULL=y
# CONFIG_HZ_PERIODIC is not set
# CONFIG_NO_HZ_IDLE is not set

# kernel/rcu/Kconfig: RCU_NOCB_CPU depends on TREE_RCU and (RCU_EXPERT ||
# NO_HZ_FULL); NO_HZ_FULL already selects it. Offloads RCU callbacks from the
# CPUs named in rcu_nocbs=. Stock.
CONFIG_RCU_NOCB_CPU=y

# RCU_BOOST (priority boosting of preempted RCU readers) is "default y if
# PREEMPT_RT" and RCU_NOCB_CPU_CB_BOOST (offloaded callbacks run SCHED_FIFO, so
# SCHED_OTHER load cannot starve them) is also "default y if PREEMPT_RT". They
# follow automatically, but Fedora's config checker reports them as unset items,
# so they are written out. 500 ms is the Kconfig default for RCU_BOOST_DELAY.
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_RCU_NOCB_CPU_CB_BOOST=y

# kernel/Kconfig.hz: a 1000 Hz tick bounds the housekeeping CPUs' timer
# granularity. Stock.
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set

# High-resolution timers are required for sub-tick clock_nanosleep/timerfd
# wake-ups (cyclictest). Stock.
CONFIG_HIGH_RES_TIMERS=y

# Debug options that add latency on a PREEMPT kernel; keep them off. Stock off.
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_PROVE_LOCKING is not set
