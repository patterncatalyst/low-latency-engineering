_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/
build/
cmake-build-*/
target/
__pycache__/
*.pyc
.venv/
.venv-ft/
*.local.md
dist/
.idea/
.vscode/
